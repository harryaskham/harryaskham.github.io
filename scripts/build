#!/usr/bin/env bash
# One-shot Jekyll build (production).
# Requires the nix-shell environment (loaded automatically by direnv).

set -euo pipefail

cd "$(dirname "$0")/.."

# Re-derive /all from static/ and the repo snapshot (offline; CI also rediscovers repos).
python3 _tools/site-index.py

python3 scripts/check-static.py
ruby scripts/check-static-routing.rb

echo "Building site..."
jekyll build
python3 scripts/check-static.py --built _site
echo "Done. Output in _site/"
