--- submit steer while Pico is streaming

--- playwright eval () => {
  const input = document.getElementById('agent-pico-input');
  const form = document.getElementById('agent-pico-composer');
  if (!input || !form) throw new Error('missing pico composer for steer');
  const transcript = document.getElementById('agent-pico-transcript');
  if (!transcript?.querySelector('.pico-assistant')) throw new Error('Pico is not visibly streaming before steer');
  input.value = 'steer while streaming from mock scenario';
  input.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'insertText', data: input.value }));
  if (typeof form.requestSubmit === 'function') form.requestSubmit();
  else form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
  const bodyAfter = document.getElementById('agent-pico-transcript')?.innerText || '';
  if (!bodyAfter.includes('steer while streaming from mock scenario')) throw new Error('optimistic steer echo missing');
  return { submitted: true, valueAfter: input.value };
}
