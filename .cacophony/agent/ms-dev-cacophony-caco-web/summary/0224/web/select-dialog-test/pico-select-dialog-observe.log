--- assert Pico slash-command suggestions

--- playwright eval () => {
  const input = document.getElementById('agent-pico-input');
  const box = document.getElementById('agent-pico-suggestions');
  if (!input || !box) throw new Error('missing pico composer suggestions');
  const setValue = (value) => {
    input.value = value;
    input.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'insertText', data: value }));
    return Array.from(box.querySelectorAll('.agent-pico-suggestion')).map(b => b.textContent.trim());
  };
  const builtins = setValue('/mo');
  if (!builtins.includes('/model') || !builtins.includes('/models') || input.getAttribute('aria-expanded') !== 'true' || box.hidden) {
    throw new Error(`missing builtin pico suggestions: ${JSON.stringify({ builtins, expanded: input.getAttribute('aria-expanded'), hidden: box.hidden })}`);
  }
  input.dispatchEvent(new KeyboardEvent('keydown', { key: 'Tab', bubbles: true, cancelable: true }));
  const completed = input.value;
  if (!completed.startsWith('/model')) throw new Error(`Tab completion did not extend /mo: ${completed}`);
  const aborts = setValue('/ab');
  if (!aborts.includes('/abort') || input.getAttribute('aria-expanded') !== 'true' || box.hidden) {
    throw new Error(`missing abort pico suggestion: ${JSON.stringify({ aborts, expanded: input.getAttribute('aria-expanded'), hidden: box.hidden })}`);
  }
  const abortButton = Array.from(box.querySelectorAll('.agent-pico-suggestion')).find((b) => b.textContent.trim() === '/abort');
  if (!abortButton) throw new Error('missing clickable /abort suggestion button');
  abortButton.click();
  const abortClicked = input.value;
  if (abortClicked !== '/abort ') throw new Error(`clicking /abort suggestion did not fill input: ${abortClicked}`);
  setValue('/ab');
  input.dispatchEvent(new KeyboardEvent('keydown', { key: 'Tab', bubbles: true, cancelable: true }));
  const abortCompleted = input.value;
  if (abortCompleted !== '/abort ') throw new Error(`Tab completion did not fill /abort: ${abortCompleted}`);
  const dynamic = setValue('/d');
  if (!dynamic.includes('/deploy')) throw new Error(`missing dynamic /deploy suggestion: ${JSON.stringify(dynamic)}`);
  input.value = '';
  input.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'deleteContentBackward', data: '' }));
  return { builtins, completed, aborts, abortClicked, abortCompleted, dynamic };
}
