--- playwright eval () => {
  const pane = document.getElementById('agent-pico-pane');
  const transcript = document.getElementById('agent-pico-transcript');
  const composer = document.getElementById('agent-pico-composer');
  const terminal = document.getElementById('agent-tty-pane');
  const result = {
    panePresent: !!pane,
    transcriptPresent: !!transcript,
    composerPresent: !!composer,
    noTerminalPane: !terminal,
    status: document.getElementById('agent-pico-status')?.textContent || null,
    bubbles: transcript ? transcript.querySelectorAll('.pico-bubble').length : 0,
    dialogPanels: transcript ? transcript.querySelectorAll('.pico-dialog-panel').length : 0,
    modelPickers: transcript ? transcript.querySelectorAll('.pico-model-picker').length : 0,
    images: transcript ? transcript.querySelectorAll('.pico-inline-image img[loading="lazy"][decoding="async"]').length : 0,
    notices: document.querySelectorAll('.pico-foot-notice').length,
    widgets: document.querySelectorAll('.pico-foot-widget').length,
    times: transcript ? transcript.querySelectorAll('time.pico-time[datetime]').length : 0,
    suggestionsHost: !!document.getElementById('agent-pico-suggestions'),
    html: (transcript?.innerHTML || '').slice(0, 700)
  };
  if (!result.panePresent || !result.transcriptPresent || !result.composerPresent || !result.noTerminalPane || result.status !== 'session ended' || result.bubbles < 3 || result.dialogPanels < 1 || result.modelPickers < 1 || result.images < 1 || result.notices < 1 || result.widgets < 1 || result.times < 2 || !result.suggestionsHost) {
    throw new Error(`pico pane fixture assertion failed: ${JSON.stringify(result)}`);
  }
  return result;
}
