--- answer mock Pico input dialog

--- playwright eval async () => {
  let input = null;
  let send = null;
  for (let i = 0; i < 120; i += 1) {
    input = document.querySelector('.pico-dialog-panel input.pico-dialog-input');
    send = Array.from(document.querySelectorAll('.pico-dialog-panel button')).find((b) => b.textContent.trim() === 'Send reply');
    if (input && send) break;
    await new Promise((resolve) => setTimeout(resolve, 100));
  }
  if (!input || !send) throw new Error('missing pico input dialog controls');
  input.value = 'ship the polished pico path';
  input.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'insertText', data: input.value }));
  send.click();
  const remaining = document.querySelectorAll('.pico-dialog-panel input.pico-dialog-input').length;
  if (remaining !== 0) throw new Error(`Pico input dialog did not clear after value reply: ${remaining}`);
  return { replied: true, remaining };
}
