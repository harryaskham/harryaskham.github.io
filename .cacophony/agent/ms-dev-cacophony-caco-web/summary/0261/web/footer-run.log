--- submit Pico help as local note

--- playwright eval () => {
  const input = document.getElementById('agent-pico-input');
  const form = document.getElementById('agent-pico-composer');
  if (!input || !form) throw new Error('missing pico composer for help note');
  input.value = '/help';
  input.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'insertText', data: input.value }));
  if (typeof form.requestSubmit === 'function') form.requestSubmit();
  else form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
  const body = document.getElementById('agent-pico-transcript')?.innerText || '';
  if (input.value || !body.includes('built-in commands:') || !body.includes('/model') || !body.includes('/abort')) {
    throw new Error(`Pico /help did not render as local note: ${JSON.stringify({ value: input.value, body })}`);
  }
  return { noted: true, valueAfter: input.value };
}
