  const link = assistant.querySelector('a[href=\"https://example.com\"]');
  const items = assistant.querySelectorAll('li');
  const beadRef = assistant.querySelector('.bead-ref, .bead-ref-link');
  // The user bubble must NOT render markdown: literal ** stays, no pico-body-md.
  const userBubble = document.querySelector('.pico-user .pico-body, .pico-interagent .pico-body');
  const userText = userBubble ? (userBubble.innerText || '') : '';
  const userIsMarkdown = !!document.querySelector('.pico-user .pico-body-md, .pico-interagent .pico-body-md');
  const result = {
    strongText: strong ? strong.textContent : null,
    codeText: code ? code.textContent : null,
    hasLink: !!link,
    linkText: link ? link.textContent : null,
    listItems: items.length,
    hasBeadRef: !!beadRef,
    userLiteralStars: userText.includes('**not bold**'),
    userIsMarkdown
  };
  if (result.strongText !== 'bold text'
      || result.codeText !== 'inline code'
      || !result.hasLink
      || result.linkText !== 'link'
      || result.listItems < 2
      || !result.hasBeadRef
      || !result.userLiteralStars
      || result.userIsMarkdown) {
