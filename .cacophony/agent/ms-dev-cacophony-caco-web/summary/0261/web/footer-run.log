  let sawReconnecting = false;
  const reconnectState = () => (window.cacoPicoReconnectState ? window.cacoPicoReconnectState() : { mode: null, attempts: 0, max: 0 });
  const waitForOffline = async () => {
    for (let i = 0; i < 150; i += 1) {
      const status = document.getElementById('agent-pico-status')?.textContent || '';
      if (/^reconnecting/.test(status)) sawReconnecting = true;
      if (status === 'disconnected') return status;
      await new Promise((resolve) => setTimeout(resolve, 100));
    }
    return document.getElementById('agent-pico-status')?.textContent || null;
  };
  await waitForOffline();
  const firstTranscript = document.getElementById('agent-pico-transcript');
  const firstState = reconnectState();
  const first = {
    status: document.getElementById('agent-pico-status')?.textContent || null,
    panePresent: !!document.getElementById('agent-pico-pane'),
    transcriptPresent: !!firstTranscript,
    noTerminalPane: !document.getElementById('agent-tty-pane'),
    hasTranscript: (firstTranscript?.innerText || '').includes('This transcript should survive a dropped socket.'),
    ended: document.getElementById('agent-pico-status')?.textContent === 'session ended',
    reconnectVisible: !document.getElementById('agent-pico-reconnect')?.hidden,
    reconnectDisabled: !!document.getElementById('agent-pico-reconnect')?.disabled,
    sawReconnecting,
    attempts: firstState.attempts,
    max: firstState.max
  };
  if (first.status !== 'disconnected' || !first.panePresent || !first.transcriptPresent || !first.noTerminalPane || !first.hasTranscript || first.ended || !first.reconnectVisible || first.reconnectDisabled || !first.sawReconnecting || first.attempts !== first.max || first.max < 1) {
    throw new Error(`pico disconnect assertion failed: ${JSON.stringify(first)}`);
  }
  document.getElementById('agent-pico-reconnect').click();
  const connectingState = reconnectState();
  const connecting = {
    status: document.getElementById('agent-pico-status')?.textContent || null,
    reconnectVisible: !document.getElementById('agent-pico-reconnect')?.hidden,
    reconnectDisabled: !!document.getElementById('agent-pico-reconnect')?.disabled,
    attempts: connectingState.attempts
  };
  if (connecting.status !== 'connecting…' || connecting.reconnectVisible || !connecting.reconnectDisabled || connecting.attempts !== 0) {
    throw new Error(`pico reconnect connecting assertion failed: ${JSON.stringify(connecting)}`);
  }
  sawReconnecting = false;
  await waitForOffline();
  const secondTranscript = document.getElementById('agent-pico-transcript');
  const secondState = reconnectState();
  const second = {
    status: document.getElementById('agent-pico-status')?.textContent || null,
    hasTranscript: (secondTranscript?.innerText || '').includes('This transcript should survive a dropped socket.'),
    noTerminalPane: !document.getElementById('agent-tty-pane'),
    reconnectVisible: !document.getElementById('agent-pico-reconnect')?.hidden,
    reconnectDisabled: !!document.getElementById('agent-pico-reconnect')?.disabled,
    sawReconnecting,
    attempts: secondState.attempts,
    max: secondState.max
  };
  if (second.status !== 'disconnected' || !second.hasTranscript || !second.noTerminalPane || !second.reconnectVisible || second.reconnectDisabled || !second.sawReconnecting || second.attempts !== second.max) {
    throw new Error(`pico reconnect assertion failed: ${JSON.stringify(second)}`);
  }
  return { first, connecting, second };
}
