--- assert mock Pico auto-reconnect recovery

--- playwright eval async () => {
  let sawReconnecting = false;
  const reconnectState = () => (window.cacoPicoReconnectState ? window.cacoPicoReconnectState() : { mode: null, attempts: 0, max: 0 });
  // Deterministic recovery proof: a non-zero attempt count can only be reached
  // by a real drop + auto-reconnect (it starts at 0 and is reset only after a
  // socket stays stable past the budget window), so `attempts >= 1` while back
  // at `attached` proves the session self-healed without operator action. The
  // transient `reconnecting` status is captured best-effort for diagnostics but
  // is not required (its window can close before polling starts).
  const waitForRecovery = async () => {
    for (let i = 0; i < 80; i += 1) {
      const status = document.getElementById('agent-pico-status')?.textContent || '';
      if (/^reconnecting/.test(status)) sawReconnecting = true;
      const st = reconnectState();
      if (st.attempts >= 1 && st.mode === 'attached') return st;
      await new Promise((resolve) => setTimeout(resolve, 100));
    }
    return reconnectState();
  };
  await waitForRecovery();
  const transcript = document.getElementById('agent-pico-transcript');
  const status = document.getElementById('agent-pico-status')?.textContent || '';
  const st = reconnectState();
  const result = {
    mode: st.mode,
    attempts: st.attempts,
    status,
    sawReconnecting,
    isLive: /live/.test(status),
    hasTranscript: (transcript?.innerText || '').includes('This session should silently recover from a transient drop.'),
    noTerminalPane: !document.getElementById('agent-tty-pane'),
    reconnectHidden: !!document.getElementById('agent-pico-reconnect')?.hidden
  };
  if (result.mode !== 'attached' || result.attempts < 1 || !result.isLive || !result.hasTranscript || !result.noTerminalPane || !result.reconnectHidden) {
    throw new Error(`pico recovery assertion failed: ${JSON.stringify(result)}`);
  }
  return result;
}
