--- assert Pico composer focus returns after Send click

--- playwright eval async () => {
  const input = document.getElementById('agent-pico-input');
  const sendBtn = document.getElementById('agent-pico-send');
  if (!input || !sendBtn) throw new Error('missing pico composer/send');
  // Wait for the attached session so Send is enabled.
  let enabled = false;
  for (let i = 0; i < 80; i += 1) {
    if (!sendBtn.disabled) { enabled = true; break; }
    await new Promise((resolve) => setTimeout(resolve, 100));
  }
  if (!enabled) throw new Error('pico Send button never enabled (session not attached)');
  input.value = 'focus check via send button';
  input.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'insertText', data: input.value }));
  // Move focus onto the Send button (as a real click would), then click it.
  sendBtn.focus();
  const focusedButton = document.activeElement === sendBtn;
  sendBtn.click();
  await new Promise((resolve) => setTimeout(resolve, 0));
  const focusReturned = document.activeElement === input;
  const valueCleared = input.value === '';
  const result = { focusedButton, focusReturned, valueCleared, active: document.activeElement && document.activeElement.id };
  if (!focusedButton || !focusReturned || !valueCleared) {
    throw new Error(`pico send-button focus return failed: ${JSON.stringify(result)}`);
  }
  return result;
}
