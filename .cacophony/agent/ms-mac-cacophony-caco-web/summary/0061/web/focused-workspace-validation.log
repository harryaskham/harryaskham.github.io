+ npx --yes @playwright/cli -s=caco-web-duty-0061-workspace-focus eval 'async () => {
    const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    const deadline = Date.now() + 30000;
    while (Date.now() < deadline) {
      const rows = document.querySelectorAll("#view-workspace .ws-agent-table tbody tr").length;
      const status = document.querySelector("#connection-status")?.textContent?.trim();
      if (rows > 0 && status && status !== "Connecting") break;
      await sleep(500);
    }
    const wrap = document.querySelector("#view-workspace .ws-pane-scroll--compact");
    const table = document.querySelector("#view-workspace .ws-agent-table");
    const row = table?.querySelector("tbody tr");
    const cells = row ? Array.from(row.children).map((td) => ({ text: td.textContent.trim().replace(/\s+/g, " "), display: getComputedStyle(td).display, w: Math.round(td.getBoundingClientRect().width) })) : [];
    const headers = table ? Array.from(table.querySelectorAll("th")).map((th) => ({ text: th.textContent.trim(), display: getComputedStyle(th).display, w: Math.round(th.getBoundingClientRect().width) })) : [];
    const wr = wrap?.getBoundingClientRect();
    const tr = table?.getBoundingClientRect();
    return {
      viewport: { w: innerWidth, h: innerHeight },
      connection: document.querySelector("#connection-status")?.textContent?.trim(),
      rowCount: table?.querySelectorAll("tbody tr").length || 0,
      wrap: wrap ? { w: Math.round(wr.width), sw: wrap.scrollWidth, overflowX: getComputedStyle(wrap).overflowX } : null,
      table: table ? { w: Math.round(tr.width), sw: table.scrollWidth, className: table.className } : null,
      headers,
      cells,
      horizontalOverflow: !!wrap && wrap.scrollWidth > Math.round(wr.width) + 4,
      text: document.querySelector("#view-workspace")?.innerText.trim().replace(/\s+/g, " ").slice(0, 500)
    };
  }'
