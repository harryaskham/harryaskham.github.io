      .filter(v => getComputedStyle(v).display !== 'none' && v.getBoundingClientRect().width && v.getBoundingClientRect().height)
      .map(v => v.id),
    text: active?.innerText?.trim().replace(/\s+/g, ' ').slice(0, 700)
  };
}
