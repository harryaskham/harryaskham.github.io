  const box = active?.getBoundingClientRect();
  const root = active || document.body;
  const overflow = Array.from(root.querySelectorAll('*'))
    .map(el => { const r = el.getBoundingClientRect(); const cs = getComputedStyle(el); return { tag: el.tagName, id: el.id || '', cls: String(el.className || '').slice(0, 80), text: (el.innerText || el.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 100), w: Math.round(r.width), sw: el.scrollWidth, h: Math.round(r.height), sh: el.scrollHeight, overflowX: cs.overflowX, overflowY: cs.overflowY }; })
    .filter(x => x.w > 0 && x.h > 0 && (x.sw > x.w + 4 || x.sh > x.h + 4))
    .slice(0, 30);
  return {
    url: location.href,
    viewport: { w: innerWidth, h: innerHeight },
    version: document.body.innerText.match(/v\d+\.\d+\.\d+/)?.[0] || null,
    activeView: active?.id,
    h1: active?.querySelector('h1,h2')?.textContent?.trim(),
    connection: document.querySelector('#connection-status')?.textContent?.trim(),
    activeBox: box ? { w: Math.round(box.width), h: Math.round(box.height) } : null,
    text: active?.innerText?.trim().replace(/\s+/g, ' ').slice(0, 900),
    overflow
  };
}
